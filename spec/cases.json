{
  "_doc": "Shared behaviour spec. macos/tests (Swift) and windows/tests (C#) both run every case; CI fails if either app disagrees. Times are offsets in seconds from `now`; `samples` are [secondsAgo, utilization] pairs, oldest first. Clock text is UTC, en-US.",
  "now": "2030-01-15T12:00:00Z",

  "timeRemaining": [
    { "resetsIn": 9030, "expect": "2:30" },
    { "resetsIn": 3600, "expect": "1:00" },
    { "resetsIn": 300,  "expect": "5m" },
    { "resetsIn": 59,   "expect": "0m" },
    { "resetsIn": -5,   "expect": null },
    { "resetsIn": null, "expect": null }
  ],

  "extractToken": [
    { "text": "{\"claudeAiOauth\":{\"accessToken\":\"tok-a\",\"refreshToken\":\"r\"}}", "expect": "tok-a" },
    { "text": "{\"accessToken\":\"tok-b\"}", "expect": "tok-b" },
    { "text": "sk-ant-oat01-xyz\n", "expect": "sk-ant-oat01-xyz" },
    { "text": "not a token", "expect": null },
    { "text": "{\"claudeAiOauth\":{\"accessToken\":\"\"}}", "expect": null }
  ],

  "sparkline": [
    { "name": "empty pads with floor bars", "width": 10, "samples": [], "expect": "▁▁▁▁▁▁▁▁▁▁" },
    { "name": "per-interval rate", "width": 10, "samples": [[540, 10], [360, 11], [180, 13], [0, 13]], "expect": "▁▁▁▁▁▁▁▃▆▁" },
    { "name": "long gap is normalized, not a spike", "width": 10, "samples": [[3780, 10], [0, 16]], "expect": "▁▁▁▁▁▁▁▁▁▂" },
    { "name": "error sentinels skipped; 3.5 rounds up", "width": 10, "samples": [[360, 10], [180, -1], [0, 13]], "expect": "▁▁▁▁▁▁▁▁▁▅" },
    { "name": "clamps at full bar", "width": 10, "samples": [[180, 10], [0, 20]], "expect": "▁▁▁▁▁▁▁▁▁█" }
  ],

  "resetLine": [
    { "name": "no window", "utilization": 0, "resetsIn": null, "samples": [],
      "expect": "No active 5-hour window — starts on your next Claude request" },
    { "name": "just reset", "utilization": 10, "resetsIn": -10, "samples": [],
      "expect": "Window just reset — refreshing soon" },
    { "name": "capped", "utilization": 100, "resetsIn": 5400, "samples": [],
      "expect": "Capped — resets in 1h 30m (@ 1:30 PM)" },
    { "name": "too few samples", "utilization": 20, "resetsIn": 7200, "samples": [[180, 19], [0, 20]],
      "expect": "Resets @ 2:00 PM · click to refresh" },
    { "name": "idle", "utilization": 20, "resetsIn": 7200, "samples": [[720, 20], [540, 20], [360, 20], [180, 20], [0, 20]],
      "expect": "Resets @ 2:00 PM · idle" },
    { "name": "too fresh to call idle", "utilization": 20, "resetsIn": 7200, "samples": [[300, 20], [150, 20], [0, 20]],
      "expect": "Resets @ 2:00 PM · measuring…" },
    { "name": "on pace", "utilization": 40, "resetsIn": 10800, "samples": [[720, 36], [540, 37], [360, 38], [180, 39], [0, 40]],
      "expect": "Resets @ 3:00 PM · 20%/h · safe ≤ 20%/h" },
    { "name": "over pace", "utilization": 53, "resetsIn": 9000, "samples": [[540, 47], [360, 49], [180, 51], [0, 53]],
      "expect": "Resets @ 2:30 PM · 40%/h over safe 19%/h · 100% in 1h 10m" },
    { "name": "sleep gap restarts the window", "utilization": 30, "resetsIn": 7200, "samples": [[2000, 10], [360, 28], [180, 29], [0, 30]],
      "expect": "Resets @ 2:00 PM · 20%/h · safe ≤ 35%/h" }
  ],

  "statusError": [
    { "status": 200, "retryAfter": null, "body": "{}", "expect": null },
    { "status": 401, "retryAfter": null, "body": "", "expect": "Your Claude token is invalid or expired. Run `claude` in a terminal to sign back in." },
    { "status": 403, "retryAfter": null, "body": "", "expect": "Access forbidden. Your account may not have access to the usage API." },
    { "status": 429, "retryAfter": 30, "body": "", "expect": "Rate limited by Anthropic — retrying in 30 seconds." },
    { "status": 429, "retryAfter": null, "body": "", "expect": "Rate limited by Anthropic. Will retry shortly." },
    { "status": 500, "retryAfter": null, "body": "oops", "expect": "Anthropic returned HTTP 500. oops" }
  ],

  "newestWindows": [
    { "name": "skips drafts, prereleases and Mac-only; highest version wins", "releases": [
        { "tag_name": "v0.3.0", "assets": [{ "name": "claude-limits-windows-0.3.0.zip" }] },
        { "tag_name": "v0.3.2", "draft": true, "assets": [{ "name": "claude-limits-windows-0.3.2.zip" }] },
        { "tag_name": "v0.3.1", "assets": [{ "name": "claude-limits-macos-0.3.1.zip" }, { "name": "claude-limits-windows-0.3.1.zip" }] },
        { "tag_name": "v0.4.0", "prerelease": true, "assets": [{ "name": "claude-limits-windows-0.4.0.zip" }] },
        { "tag_name": "v0.5.0", "assets": [{ "name": "claude-limits-macos-0.5.0.zip" }] } ],
      "expect": "v0.3.1" },
    { "name": "asset name is case-insensitive", "releases": [
        { "tag_name": "v0.2.0", "draft": false, "assets": [{ "name": "Claude-Limits-Windows-0.2.0.ZIP" }] } ],
      "expect": "v0.2.0" },
    { "name": "nothing usable", "releases": [{ "tag_name": "v0.1.0", "assets": [] }], "expect": null }
  ],

  "weeklyRows": [
    { "name": "legacy buckets", "response": { "seven_day": { "utilization": 34.4, "resets_at": null }, "seven_day_opus": { "utilization": 12.5 } },
      "expect": "Overall=34, Opus=13" },
    { "name": "limits fallback", "response": { "seven_day": null, "limits": [
        { "kind": "session", "group": "session", "percent": 19 },
        { "kind": "weekly_scoped", "group": "weekly", "percent": 2, "scope": { "model": { "display_name": "Fable" } } },
        { "kind": "weekly", "group": "weekly", "percent": 7, "scope": null } ] },
      "expect": "Fable=2, Overall=7" },
    { "name": "nothing", "response": {}, "expect": "" }
  ],

  "rollover": [
    { "name": "same window keeps history", "steps": [{ "t": -360, "u": 40, "r": 3600 }, { "t": -180, "u": 42, "r": 3600 }, { "t": 0, "u": 43, "r": 3600 }], "expectCount": 3 },
    { "name": "resets_at advanced", "steps": [{ "t": -360, "u": 40, "r": 3600 }, { "t": -180, "u": 41, "r": 3600 }, { "t": 0, "u": 41, "r": 21600 }], "expectCount": 1 },
    { "name": "big drop", "steps": [{ "t": -180, "u": 60, "r": 3600 }, { "t": 0, "u": 2, "r": 3600 }], "expectCount": 1 },
    { "name": "small drop is jitter", "steps": [{ "t": -180, "u": 10, "r": 3600 }, { "t": 0, "u": 6, "r": 3600 }], "expectCount": 2 }
  ],

  "calls": [
    {"fn": "next_attempt", "args": [0], "expect": "trying now…"},
    {"fn": "next_attempt", "args": [45], "expect": "45s"},
    {"fn": "next_attempt", "args": [125], "expect": "2m 5s"},
    {"fn": "next_attempt", "args": [3725], "expect": "1h 2m"},
    {"fn": "relative_time", "args": [0, 0], "expect": "0s ago"},
    {"fn": "relative_time", "args": [-75, 0], "expect": "1m 15s ago"},
    {"fn": "relative_time", "args": [-3725, 0], "expect": "1h 2m ago"},
    {"fn": "is_newer_version", "args": ["v0.3.1", "0.3.0"], "expect": true},
    {"fn": "is_newer_version", "args": ["0.3.0", "v0.3.0"], "expect": false},
    {"fn": "is_newer_version", "args": ["0.1.10", "0.1.9"], "expect": true},
    {"fn": "is_newer_version", "args": ["0.2", "0.2.0"], "expect": false},
    {"fn": "is_newer_version", "args": ["0.2.0", "0.10.0"], "expect": false},
    {"fn": "flag_value", "args": [["a", "--fixture", "x.json", "--snapshot-all"], "--fixture"], "expect": "x.json"},
    {"fn": "flag_value", "args": [["--fixture"], "--fixture"], "expect": null},
    {"fn": "flag_value", "args": [["a"], "--snapshot-all"], "expect": null},
    {"fn": "source_hint", "args": ["file", true, "p"], "expect": "Path to a Claude credentials JSON or a file containing just the access token."},
    {"fn": "source_hint", "args": ["auto", true, "~\\.claude\\.credentials.json"], "expect": "Reads the credentials file Claude Code writes when you sign in (~\\.claude\\.credentials.json, or under CLAUDE_CONFIG_DIR when that's set)."},
    {"fn": "source_hint", "args": ["auto", false, "~/.claude/.credentials.json"], "expect": "We check the macOS Keychain (where Claude Code stores credentials by default), then fall back to common file paths like ~/.claude/.credentials.json."},
    {"fn": "wait_status", "args": [90.5, 0], "expect": "Rate limited — wait 90s before testing again."},
    {"fn": "wait_status", "args": [-5, 0], "expect": null},
    {"fn": "wait_status", "args": [null, 0], "expect": null},
    {"fn": "backoff_error", "args": [120, 0], "expect": "Rate limited by Anthropic — retrying in 120 seconds."},
    {"fn": "backoff_error", "args": [null, 0], "expect": null},
    {"fn": "new_window", "args": ["A", "B"], "expect": true},
    {"fn": "new_window", "args": ["B", "B"], "expect": false},
    {"fn": "new_window", "args": [null, "B"], "expect": false},
    {"fn": "filled_blocks", "args": [0.5, 24], "expect": 1},
    {"fn": "filled_blocks", "args": [50, 24], "expect": 12},
    {"fn": "filled_blocks", "args": [0, 24], "expect": 0},
    {"fn": "filled_blocks", "args": [150, 24], "expect": 24},
    {"fn": "flyout_origin", "args": [true, 1700, 1000, 1800, 1032, 0, 0, 1920, 1040, 360, 400, 12, 6], "expect": "(1452, 606)"},
    {"fn": "flyout_origin", "args": [true, 1700, 4, 1800, 36, 0, 0, 1920, 1040, 360, 400, 12, 6], "expect": "(1452, 30)"},
    {"fn": "flyout_origin", "args": [false, 1850, 1060, 1850, 1060, 0, 0, 1920, 1040, 360, 400, 12, 6], "expect": "(1566, 646)"},
    {"fn": "flyout_origin", "args": [false, 30, 500, 30, 500, -1920, 0, 0, 1080, 360, 400, 12, 6], "expect": "(-354, 112)"},
    {"fn": "hours_minutes", "args": [9000], "expect": "150h 0m"},
    {"fn": "hours_minutes", "args": [300], "expect": "5h 0m"},
    {"fn": "wave_frame", "args": [0], "expect": "█▇▆▅▄▃▂▁▁▁"},
    {"fn": "wave_frame", "args": [13], "expect": "▃▄▅▆▇█▇▆▅▄"},
    {"fn": "error_frame", "args": [5, "Rate limited", 22], "expect": "▃▄▅▆▇█▇▆▅▄"},
    {"fn": "error_frame", "args": [40, "Rate limited by Anthropic — retrying soon.", 12], "expect": "by Anthropic"},
    {"fn": "should_poll", "args": [null, null, 0], "expect": true},
    {"fn": "should_poll", "args": [60, null, 0], "expect": false},
    {"fn": "should_poll", "args": [null, -60, 0], "expect": false},
    {"fn": "should_poll", "args": [null, -600, 0], "expect": true},
    {"fn": "cooling_down", "args": [-2, 0], "expect": true},
    {"fn": "cooling_down", "args": [-10, 0], "expect": false},
    {"fn": "cooling_down", "args": [null, 0], "expect": false},
    {"fn": "alert_title", "args": [80], "expect": "Claude usage at 80%"},
    {"fn": "alert_body", "args": [95], "expect": "About to cap — finish the current task and pause."},
    {"fn": "credits_text", "args": [1234, 5000, "USD"], "expect": "12.34 / 50.00 USD"},
    {"fn": "credits_text", "args": [3, 0, "EUR"], "expect": "0.03 / 0.00 EUR"},
    {"fn": "percent", "args": [17.6], "expect": 18},
    {"fn": "percent", "args": [0.4], "expect": 0},
    {"fn": "icon_level", "args": [50], "expect": 0},
    {"fn": "icon_level", "args": [85], "expect": 1},
    {"fn": "icon_level", "args": [97], "expect": 2},
    {"fn": "tray_text", "args": [42, false, null], "expect": "42"},
    {"fn": "tray_text", "args": [null, true, "rate limit"], "expect": "!"},
    {"fn": "tray_text", "args": [null, false, "—"], "expect": "–"},
    {"fn": "tray_level", "args": [42, 42, false], "expect": 0},
    {"fn": "tray_level", "args": [96, 96, false], "expect": 2},
    {"fn": "tray_level", "args": [null, 0, true], "expect": 3},
    {"fn": "update_status", "args": ["v9.9.9", null, "0.3.1"], "expect": "Update v9.9.9 available — click “Update to v9.9.9”."},
    {"fn": "update_status", "args": [null, null, "0.3.1"], "expect": "You're on the latest version (v0.3.1)."},
    {"fn": "update_status", "args": [null, "offline", "0.3.1"], "expect": "Couldn't reach GitHub: offline"},
    {"fn": "update_button", "args": ["v9.9.9"], "expect": "Update to v9.9.9"},
    {"fn": "update_button", "args": [null], "expect": "Check for updates"},
    {"fn": "updating_status", "args": ["v9.9.9"], "expect": "Updating to v9.9.9… the app will relaunch when done."},
    {"fn": "updating_notice", "args": ["v9.9.9", "tray icon"], "expect": "Installing v9.9.9 — the tray icon will return in a few seconds."},
    {"fn": "test_status", "args": [42.4], "expect": "OK — current session at 42%"},
    {"fn": "test_status", "args": [null], "expect": "Connected, but no five_hour data."},
    {"fn": "raw_token", "args": ["  sk-ant-abc  "], "expect": "sk-ant-abc"},
    {"fn": "raw_token", "args": ["not a token"], "expect": null},
    {"fn": "click_effect", "args": [60, null, 0], "expect": "blocked"},
    {"fn": "click_effect", "args": [null, -2, 0], "expect": "cooling"},
    {"fn": "click_effect", "args": [null, null, 0], "expect": "fetch"},
    {"fn": "click_effect", "args": [-5, -60, 0], "expect": "fetch"},
    {"fn": "dot_on_open", "args": [true, -60, false, null, null, 0], "expect": "connected"},
    {"fn": "dot_on_open", "args": [false, null, true, null, null, 0], "expect": "unverified"},
    {"fn": "dot_on_open", "args": [false, null, false, 120, null, 0], "expect": "unverified"},
    {"fn": "dot_on_open", "args": [false, null, false, null, null, 0], "expect": "probe"}
  ]
}
